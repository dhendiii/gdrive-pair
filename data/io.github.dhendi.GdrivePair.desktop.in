[Desktop Entry]
Type=Application
Name=Gdrive-Pair
Comment=Keep Google Drive folders in sync with this computer
Exec=@BIN_DIR@/gdrive-pair
Icon=io.github.dhendi.GdrivePair
Terminal=false
Categories=Utility;Network;FileTransfer;
Keywords=google;drive;rclone;sync;backup;cloud;
StartupNotify=true
X-GNOME-UsesNotifications=true
